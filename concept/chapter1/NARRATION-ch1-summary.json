        "fitsWindow": false
      }
    },
    {
      "n": 11,
      "start": 51.4,
      "end": 56.6,
      "dur": 5.2,
      "text": "יהודים ישבו בצפון חצי האי לכל הפחות מאז המאה הראשונה לספירה — בח׳יבר, בתימא ובית׳רב, שתיקרא לימים אלמדינה.",
      "recorded": {
        "file": "narration/11.mp3",
