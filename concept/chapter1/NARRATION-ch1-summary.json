        "fitsWindow": false
      }
    },
    {
      "n": 4,
      "start": 16.4,
      "end": 20.6,
      "dur": 4.2,
      "text": "ואת המסורת הזאת, אם מתבוננים בה במבט ביקורתי, יש לקחת בעירבון מוגבל.",
      "recorded": {
        "file": "narration/04.mp3",
        "seconds": 6.25,
        "fitsWindow": false
      }
    },
    {
      "n": 5,
      "start": 21.4,
      "end": 26.4,
      "dur": 5.0,
      "text": "מצפון לחצי האי ישבו שתי אימפריות. מצפון־מערב הביזנטית, שהחליפה את רומא העתיקה, ודתה נוצרית אורתודוקסית.",
      "recorded": {
        "file": "narration/05.mp3",
        "seconds": 10.78,
        "fitsWindow": false
      }
    },
    {
      "n": 6,
      "start": 26.6,
      "end": 31.6,
      "dur": 5.0,
      "text": "מצפון־מזרח הסאסאנית־פרסית, ובירתה קטסיפון. האליטה שלה זורואסטרית: אל טוב ואל רע שנלחמים זה בזה.",
      "recorded": {
        "file": "narration/06.mp3",
        "seconds": 10.87,
        "fitsWindow": false
      }
    },
    {
      "n": 7,
      "start": 32.4,
      "end": 36.8,
      "dur": 4.4,
      "text": "בצפון חצי האי חיו שבטים נוודים, בני חסות של האימפריות. הם נדדו צפונה מאזור תימן",
      "recorded": {
        "file": "narration/07.mp3",
        "seconds": 8.34,
        "fitsWindow": false
      }
    },
    {
      "n": 8,
      "start": 37.0,
      "end": 41.6,
      "dur": 4.6,
      "text": "ושימשו מתווכים — בעיקר לשמירה על נתיבי הסחר: משי ותבלינים. גסאן היה בן חסות של הביזנטים, ולח׳ם של הסאסאנים.",
      "recorded": {
        "file": "narration/08.mp3",
