        "fitsWindow": false
      }
    },
    {
      "n": 9,
      "start": 42.4,
      "end": 46.2,
      "dur": 3.8,
      "text": "אזור החג׳אז היה חבוי יחסית, והאימפריות לא גילו בו עניין רב.",
      "recorded": {
