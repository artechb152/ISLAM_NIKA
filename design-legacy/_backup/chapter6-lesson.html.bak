    paras:[
      "העלייה לרגל היא ריטואל המתקשר לאירועים שחוו הגר וישמעאל כשגורשו מביתו של אברהם, לפי המסורת המוסלמית, ומתחילה ביום ה-8 לחודש ד׳ו אלחג׳ה, החודש ה-12 בלוח השנה ההג׳רי. הנרטיב הנ״ל התקבל באסלאם, מפני שהיה קושי להגן על מנהג פגאני מובהק שהתקיים בחצי האי ערב, בכעבה, עוד הרבה לפני תקופת האסלאם.",
      "בראשית תקופת האסלאם היה קושי גדול להתנייד לחצי האי ערב, והדבר היה כרוך בהליכה ימים רבים במדברות תוך סכנה גדולה משודדים, חיות רעות, חום המדבר ועוד, ובשל כך העלייה לרגל אינה חובה כמו שאר מצוות היסוד, אלא תלויה ביכולתו של האדם, הן בהיבט הכלכלי והן בהיבט הבריאותי, והמוסלמי נדרש להתאמץ לשם כך עד גבול מסוים, פעם אחת במהלך חייו."
    ],
    highlight:{ t:"מדוע החג׳ אינו חובה מוחלטת?", p:"בשל הקושי והסכנה שבמסע במדבר, העלייה לרגל תלויה ביכולתו הכלכלית והבריאותית של האדם — פעם אחת במהלך חייו." } },

  { sec:"החג׳", type:"content",
    kicker:"עמוד חמישי · החג׳", title:"הכנה לחג׳ — אחראם",
    paras:[
      "על המוסלמי העולה לרגל להיכנס למצב של טהרה מקסימלית (אחראם), ועליו להתגלח, להסתפר, לקצוץ את ציפורניו, ולאחר מכן להתעטף בבגד לבן המקיף את כתפו, וכן בבגד לבן נוסף המקיף את מותניו. על הבגדים להיות ללא תפרים או כפלים אלא חלקים.",
      "חובת ההיטהרות מתחילה מאז שהמוסלמי מתקרב לאזור גאוגרפי מסוים סמוך למכה (נקרא בערבית מיקאת)."
    ] },

  { sec:"החג׳", type:"order",
    kicker:"תרגול · סידור לפי סדר", title:"תחנות החג׳",
    intro:"סדרו את שלבי החג׳ לפי הסדר הנכון — לחצו על השלבים אחד אחרי השני.",
    items:[
      "אחראם — היטהרות ולבישת הבגד הלבן",
      "טַואף — הקפת הכעבה שבע פעמים",
      "סַעי — הריצה בין הגבעות צפא ומרוה",
      "יום ערפה — ה״עמידה״ (וקוף) במישור ערפה",
      "מוזדליפה — איסוף האבנים",
      "מינא — רגימת השטן באבנים",
      "עיד אלאד׳חא — חג הקרבן"
    ],
    good:"מצוין! זהו סדר תחנות החג׳: אחראם, טַואף, סַעי, יום ערפה (וקוף), מוזדליפה, מינא (רגימת השטן) וחג הקרבן." },

  { sec:"החג׳", type:"content",
    kicker:"עמוד חמישי · החג׳", title:"תחנות החג׳ — הרחבה",
    paras:[
      "הריטואל הראשון הוא הקפת הכעבה (טואף) שבע פעמים (שבע הוא מספר טיפולוגי בתחומים רבים) נגד כיוון השעון, תוך אמירת פסוקי קוראן ודברי שבח לאללה.",
      "הריטואל השני הוא הריצה בין הגבעות צפא ומרוה (סעי). ריצה זו מתקשרת לריצתה של הגר בין שתי הגבעות הללו במהלך חיפוש אחר מים לבנה ישמעאל, עד שהמלאך גבריאל המציא מבין שתי הגבעות את מעיין הזמזם, הנודע בקדושתו ובסגולותיו באסלאם.",
      "הריטואל השלישי, והחשוב ביותר מבין כולם, הינו יום ערפה. המוסלמי נוסע להר ערפה הנמצא מספר קילומטרים ממכה, ומתכונן לפולחן סביב ההר, שזה מצהרי היום השני של החג׳ עד לבוקרו של יום השלישי. ביום הזה הוא עולה להר (מוסלמים רבים נוהגים לצום בו), תוך כדי קריאת תפילות (תלביה), ועם ירידתו עומד במישור ערפה ומבצע את ה״עמידה״ (וקוף). הר ערפה באסלאם נחשב להר קדוש, ומסורות רבות סופרו על אודותיו, בין היתר שזה ההר שאדם וחוה ידעו זה את זו לאחר גירושם מגן עדן, וכן ההר שעליו עקד אברהם את ישמעאל בנו.",
      "עם סיום הוקוף ולקראת ערב, חוזר המוסלמי למכה, ועוצר במקום הנקרא מוזדליפה, שם הוא אוסף אבנים ונוסע ל״מינא״, שם הוא מבצע ריטואל של זריקת אבנים על השטן. רגימת השטן באבנים היא לזכר זה שהשטן ניסה לפתות את אברהם לא לעקוד את ישמעאל בנו לעולה, וזריקת האבנים מסמלת את הנזיפה שקיבל כאשר לא עלה בידו לפתות את אברהם."
    ] },

  { sec:"החג׳", type:"content",
    kicker:"עמוד חמישי · החג׳", title:"עיד אלאד׳חא — חג הקרבן",
    paras:[
      "עם החזרה למכה מתחיל חג הקרבן (עיד אלאד׳חא), המתבטא בשחיטת כבש, לזכר הכבש ששחט אברהם במקום את בנו ישמעאל. חג הקרבן נמשך ארבעה ימים, והיום הראשון שלו חופף ליום האחרון של החג׳. עם סיום חג הקרבן מבצע המוסלמי הקפות נוספות סביב הכעבה."
    ],
    blessing:{ ar:"حج مبرور وسعي مشكور وذنب مغفور", he:"חג מקובל, טקס הריצה מבורך והחטא נמחל — ברכה רווחת בתקופת החג׳." } },

  { sec:"סיכום", type:"summary",
    kicker:"סיכום", title:"חמשת עמודי האסלאם",
    items:[
      { nm:"השהאדה", d:"העדות שאין אל מבלעדי אללה ומוחמד שליחו" },
      { nm:"התפילה", d:"חמש תפילות ביום בזמנים קבועים" },
      { nm:"הצדקה", d:"‏2.5% מהמאזן השנתי לנזקקים" },
      { nm:"צום רמדאן", d:"צום מעלות השחר עד השקיעה, חודש שלם" },
      { nm:"החג׳", d:"עלייה לרגל למכה, פעם בחיים לפי יכולת" }
    ],
    blessing:{ ar:"حج مبرور وسعي مشكور وذنب مغفور", he:"חג מקובל, טקס הריצה מבורך והחטא נמחל." } },

  { sec:"סיכום", type:"quiz",
    kicker:"בדיקת הבנה מסכמת", title:"מה זכרנו מהפרק?",
    questions:[
      { q:"מהם חמשת עמודי האסלאם?",
        options:[
          { t:"השהאדה, התפילה, הצדקה, צום רמדאן והחג׳", ok:true },
          { t:"השהאדה, כיבוד הורים, איסור ריבית, הצום והחג׳", ok:false },
          { t:"התפילה, הצום, החג׳, אלג׳האד והזכּאת", ok:false }
        ] },
      { q:"היכן וכיצד ניתנה מצוות התפילה למוחמד?",
        options:[
          { t:"במסע הלילי בשנת 621, עת עלה לשמים", ok:true },
          { t:"בהתגלות הראשונה בליל אלקדר", ok:false },
          { t:"בעת ההגירה למדינה", ok:false }
        ] },
      { q:"עם מה מתקשר ריטואל הסַעי (הריצה בין צפא ומרוה)?",
        options:[
          { t:"ריצתה של הגר בחיפוש מים לבנה ישמעאל", ok:true },
          { t:"מסעו של מוחמד ממכה למדינה", ok:false },
          { t:"עקדת ישמעאל על הר ערפה", ok:false }
        ] },
      { q:"מהו עיד אלאד׳חא (חג הקרבן)?",
        options:[
          { t:"שחיטת כבש לזכר הכבש ששחט אברהם במקום ישמעאל", ok:true },
          { t:"חג שבירת הצום עם סיום רמדאן", ok:false },
          { t:"חג ראיית הירח בתחילת החודש", ok:false }
        ] }
    ] },

  { sec:"סיכום", type:"end",
    title:"סיימת את פרק 6", sub:"חמש מצוות היסוד" }
];

/* ===================== ENGINE ===================== */
const stage = document.getElementById('stage');
const bar = document.getElementById('bar');
const counter = document.getElementById('counter');
const secName = document.getElementById('secName');
const prevBtn = document.getElementById('prev');
const nextBtn = document.getElementById('next');
const hint = document.getElementById('hint');
const dotsEl = document.getElementById('dots');
SECTIONS.forEach(()=> dotsEl.appendChild(el('<span class="dot"></span>')));
const crownSVG = '<div class="crown"><svg viewBox="0 0 16 16"><rect x="3.2" y="3.2" width="9.6" height="9.6"/><rect x="3.2" y="3.2" width="9.6" height="9.6" transform="rotate(45 8 8)"/></svg></div>';

const svgCheck = '<svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>';
const state = {};           // per-screen completion + score
let i = 0;

function esc(s){ const d=document.createElement('div'); d.textContent=s; return d.innerHTML; }
function el(html){ const t=document.createElement('template'); t.innerHTML=html.trim(); return t.content.firstElementChild; }
function paras(arr){ return arr.map(p=>`<p>${esc(p)}</p>`).join(''); }

function isGated(sc){ return ['mcq','tf','match','order','quiz'].includes(sc.type); }
function done(idx){ return !!(state[idx] && state[idx].done); }

function render(){
  const sc = SCREENS[i];
  stage.innerHTML = '';
  const screen = el('<div class="screen"></div>');
  screen.appendChild(BUILders[sc.type](sc));
  const card = screen.querySelector('.card');
  if(card) card.insertBefore(el(crownSVG), card.firstChild);
  stage.appendChild(screen);

  // progress (section stepper)
  const secIdx = Math.max(0, SECTIONS.indexOf(sc.sec));
  bar.style.width = (secIdx/(SECTIONS.length-1)*100)+'%';
  [...dotsEl.children].forEach((d,k)=>{ d.className = 'dot' + (k<secIdx?' done' : k===secIdx?' active' : ''); });
  counter.textContent = `מסך ${i+1} מתוך ${SCREENS.length}`;
  secName.textContent = sc.sec;

  // nav
  prevBtn.disabled = i===0;
  const last = i===SCREENS.length-1;
  nextBtn.style.display = last ? 'none' : '';
  const gated = isGated(sc) && !done(i);
  nextBtn.disabled = gated;
  hint.textContent = gated ? 'השלימו את המשימה כדי להמשיך' : '';
  window.scrollTo({top:0,behavior:'smooth'});
}
function mark(done_){ state[i]=Object.assign(state[i]||{},{done:done_}); nextBtn.disabled=false; hint.textContent=''; }

prevBtn.onclick=()=>{ if(i>0){ i--; render(); } };
nextBtn.onclick=()=>{ if(i<SCREENS.length-1 && !nextBtn.disabled){ i++; render(); } };
document.addEventListener('keydown',e=>{
  if(e.target.tagName==='BUTTON') return;
  if(e.key==='ArrowLeft' && !nextBtn.disabled && nextBtn.style.display!=='none'){ nextBtn.click(); }
  if(e.key==='ArrowRight' && !prevBtn.disabled){ prevBtn.click(); }
});

/* ---------- builders per screen type ---------- */
const BUILders = {
  story(sc){
    const c = el(`<div class="card"><div class="kicker">${esc(sc.kicker)}</div><h1 class="h">${esc(sc.title)}</h1><div class="body">${paras(sc.paras)}</div></div>`);
    const wrap = el('<div style="margin-top:24px"></div>');
    const q = el(`<div class="prompt">${esc(sc.reveal.q)}</div>`);
    const btn = el('<button class="btn primary" style="margin:0 auto;display:flex">גלה את התשובה</button>');
    const ans = el(`<div class="highlight" style="display:none;margin-top:18px"><p style="font-size:clamp(16px,1.3vw,20px);color:var(--maroon);font-weight:700">${esc(sc.reveal.a)}</p></div>`);
    btn.onclick=()=>{ ans.style.display='block'; btn.style.display='none'; };
    wrap.append(q,btn,ans); c.appendChild(wrap);
    return c;
  },
  objective(sc){
    const c = el(`<div class="card"><div class="kicker">${esc(sc.kicker)}</div><h1 class="h">${esc(sc.title)}</h1><p class="lead-in">${esc(sc.lead)}</p></div>`);
    const ul = el('<ul class="obj"></ul>');
    sc.objectives.forEach(o=> ul.appendChild(el(`<li><svg viewBox="0 0 24 24"><path d="M12 2l2.6 6.9L22 9.3l-5.4 4.6L18.2 22 12 17.8 5.8 22l1.6-8.1L2 9.3l7.4-.4z"/></svg><span>${esc(o)}</span></li>`)) );
    c.appendChild(ul);
    c.appendChild(el(`<div class="highlight"><div class="t">מצוות רבות — וחמישה עמודים</div><p>${esc(sc.context)}</p></div>`));
    const pg = el('<div class="pillars"></div>');
    sc.pillars.forEach((p,k)=> pg.appendChild(el(`<div class="p"><div class="n">${k+1}</div><div class="nm">${esc(p)}</div></div>`)) );
    c.appendChild(pg);
    return c;
  },
  content(sc){
    const c = el(`<div class="card"><div class="kicker">${esc(sc.kicker)}</div><h2 class="h">${esc(sc.title)}</h2><div class="body">${paras(sc.paras)}</div></div>`);
    if(sc.highlight) c.appendChild(el(`<div class="highlight"><div class="t"><svg viewBox="0 0 24 24"><path d="M12 2 3 7v6c0 5 3.8 8.5 9 9 5.2-.5 9-4 9-9V7z"/></svg>${esc(sc.highlight.t)}</div><p>${esc(sc.highlight.p)}</p></div>`));
    if(sc.blessing) c.appendChild(el(`<div class="blessing" style="margin-top:22px"><div class="ar">${esc(sc.blessing.ar)}</div><div class="he">${esc(sc.blessing.he)}</div></div>`));
    return c;
  },
  mcq(sc){
    const c = el(`<div class="card"><div class="kicker">${esc(sc.kicker)}</div><div class="prompt">${esc(sc.prompt)}</div></div>`);
    const opts = el('<div class="opts"></div>');
    const fb = el(`<div class="feedback"></div>`);
    sc.options.forEach(o=>{
      const b = el(`<button class="opt"><span class="mk">${svgCheck}</span><span>${esc(o.t)}</span></button>`);
      b.onclick=()=>{
        if(done(i)) return;
        [...opts.children].forEach(x=>{ x.classList.add('locked'); if(!x.classList.contains('sel')) x.classList.add('dim'); });
        if(o.ok){ b.classList.add('correct'); fb.className='feedback show good'; fb.innerHTML=esc(sc.good); }
        else{ b.classList.add('wrong'); const right=[...opts.children][sc.options.findIndex(x=>x.ok)]; right.classList.remove('dim'); right.classList.add('correct'); fb.className='feedback show bad'; fb.innerHTML=esc(sc.bad); }
        mark(true);
      };
      opts.appendChild(b);
    });
    c.append(opts,fb); return c;
  },
  tf(sc){
    const c = el(`<div class="card"><div class="kicker">${esc(sc.kicker)}</div><div class="prompt">${esc(sc.prompt)}</div></div>`);
    const row = el('<div class="tf"></div>');
    const fb = el(`<div class="feedback"></div>`);
    const trueB = el('<button><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>נכון</button>');
    const falseB = el('<button><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>לא נכון</button>');
    function answer(val,btn){
      if(done(i)) return;
      trueB.classList.add('locked'); falseB.classList.add('locked');
      const ok = val===sc.answer;
      btn.classList.add(ok?'correct':'wrong');
      fb.className='feedback show '+(ok?'good':'bad'); fb.innerHTML=esc(ok?sc.good:sc.bad);
      if(!ok){ (sc.answer?trueB:falseB).classList.add('correct'); }
      mark(true);
    }
    trueB.onclick=()=>answer(true,trueB); falseB.onclick=()=>answer(false,falseB);
    row.append(trueB,falseB); c.append(row,fb); return c;
  },
  match(sc){
    const c = el(`<div class="card"><div class="kicker">${esc(sc.kicker)}</div><h2 class="h">${esc(sc.title)}</h2><p class="lead-in" style="margin-bottom:18px">${esc(sc.intro)}</p></div>`);
    const grid = el('<div class="match"></div>');
    const colL = el(`<div class="col"><h4>${esc(sc.leftTitle)}</h4></div>`);
    const colR = el(`<div class="col"><h4>${esc(sc.rightTitle)}</h4></div>`);
    const fb = el(`<div class="feedback"></div>`);
    const rightOrder = shuffle(sc.pairs.map((p,idx)=>({t:p.r,idx})));
    let sel=null, solved=0;
    sc.pairs.forEach((p,idx)=>{ const chip=el(`<button class="chip" data-idx="${idx}">${esc(p.l)}</button>`); chip.onclick=()=>selectLeft(chip,idx); colL.appendChild(chip); });
    rightOrder.forEach(r=>{ const chip=el(`<button class="chip" data-idx="${r.idx}">${esc(r.t)}</button>`); chip.onclick=()=>selectRight(chip,r.idx); colR.appendChild(chip); });
    function selectLeft(chip,idx){ if(chip.classList.contains('done')) return; colL.querySelectorAll('.chip').forEach(x=>x.classList.remove('sel')); chip.classList.add('sel'); sel={chip,idx}; }
    function selectRight(chip,idx){
      if(chip.classList.contains('done')||!sel) return;
      if(idx===sel.idx){ sel.chip.classList.remove('sel'); sel.chip.classList.add('done'); chip.classList.add('done'); sel=null; solved++;
        if(solved===sc.pairs.length){ fb.className='feedback show good'; fb.innerHTML=esc(sc.good); mark(true); } }
      else{ chip.classList.add('flash'); setTimeout(()=>chip.classList.remove('flash'),380); }
    }
    grid.append(colR,colL); c.append(grid,fb); return c;
  },
  order(sc){
    const c = el(`<div class="card"><div class="kicker">${esc(sc.kicker)}</div><h2 class="h">${esc(sc.title)}</h2><p class="lead-in" style="margin-bottom:18px">${esc(sc.intro)}</p></div>`);
    const grid = el('<div class="order"></div>');
    const poolCol = el('<div class="pool"><h4>השלבים</h4></div>');
    const seqCol  = el('<div class="seq"><h4>הסדר שלכם</h4></div>');
    const pool = el('<div style="display:grid;gap:10px"></div>');
    const seq  = el('<div style="display:grid;gap:10px"></div>');
    poolCol.appendChild(pool); seqCol.appendChild(seq);
    grid.append(poolCol, seqCol);
    const fb = el(`<div class="feedback"></div>`);
    const order = [];
    function refresh(){
      seq.innerHTML='';
      if(order.length===0){ seq.appendChild(el('<div class="placeholder">לחצו על השלבים לפי הסדר</div>')); return; }
      order.forEach((it,k)=> seq.appendChild(el(`<div class="step"><span class="idx filled">${k+1}</span><span>${esc(it)}</span></div>`)) );
    }
    shuffle(sc.items).forEach((it)=>{
      const s = el(`<button class="step"><span class="idx">+</span><span>${esc(it)}</span></button>`);
      s.onclick=()=>{ if(s.classList.contains('placed')) return; s.classList.add('placed'); s.style.display='none'; order.push(it); refresh(); if(order.length===sc.items.length) check(); };
      pool.appendChild(s);
    });
    function check(){
      let allOk=true;
      [...seq.children].forEach((row,k)=>{ const ok=order[k]===sc.items[k]; row.classList.add(ok?'ok':'no'); if(!ok) allOk=false; });
      if(allOk){ fb.className='feedback show good'; fb.innerHTML=esc(sc.good); mark(true); }
      else{
        fb.className='feedback show bad';
        fb.innerHTML='כמעט! חלק מהשלבים אינם בסדר הנכון. <button class="reset" style="background:none;border:none;color:var(--maroon);font:inherit;font-weight:700;cursor:pointer;text-decoration:underline">נסו שוב</button>';
        fb.querySelector('.reset').onclick=reset;
      }
    }
    function reset(){ order.length=0; fb.className='feedback'; pool.querySelectorAll('.step').forEach(s=>{ s.classList.remove('placed'); s.style.display=''; }); refresh(); }
    refresh();
    c.append(grid, fb); return c;
  },
  flip(sc){
    const c = el(`<div class="card"><div class="kicker">${esc(sc.kicker)}</div><h2 class="h">${esc(sc.title)}</h2><p class="lead-in" style="margin-bottom:18px">${esc(sc.intro)}</p></div>`);
    const grid = el('<div class="flips"></div>');
    sc.cards.forEach(card=>{
      const f = el(`<div class="flip"><div class="inner"><div class="face front"><div class="term">${esc(card.term)}</div><div class="hint">לחצו לחשיפה</div></div><div class="face back">${esc(card.def)}</div></div></div>`);
      f.onclick=()=>f.classList.toggle('on');
      grid.appendChild(f);
    });
    c.appendChild(grid); return c;
  },
  summary(sc){
    const c = el(`<div class="card"><div class="kicker">${esc(sc.kicker)}</div><h1 class="h">${esc(sc.title)}</h1></div>`);
    const g = el('<div class="sumgrid"></div>');
    sc.items.forEach((s,k)=> g.appendChild(el(`<div class="s"><div class="n">${k+1}</div><div class="nm">${esc(s.nm)}</div><div class="d">${esc(s.d)}</div></div>`)) );
    c.appendChild(g);
    c.appendChild(el(`<div class="blessing"><div class="ar">${esc(sc.blessing.ar)}</div><div class="he">${esc(sc.blessing.he)}</div></div>`));
    return c;
  },
  quiz(sc){
    const c = el(`<div class="card"><div class="kicker">${esc(sc.kicker)}</div><h2 class="h">${esc(sc.title)}</h2></div>`);
    let answered=0, correct=0;
    sc.questions.forEach((q,qi)=>{
      const block = el(`<div style="margin-top:${qi?28:18}px"></div>`);
      block.appendChild(el(`<div class="prompt" style="font-size:clamp(15px,1.25vw,19px);margin-bottom:14px">${qi+1}. ${esc(q.q)}</div>`));
      const opts = el('<div class="opts"></div>');
      let locked=false;
      q.options.forEach(o=>{
        const b = el(`<button class="opt"><span class="mk">${svgCheck}</span><span>${esc(o.t)}</span></button>`);
        b.onclick=()=>{
          if(locked) return; locked=true;
          [...opts.children].forEach(x=>{ x.classList.add('locked'); if(x!==b) x.classList.add('dim'); });
          if(o.ok){ b.classList.add('correct'); correct++; }
          else{ b.classList.add('wrong'); const right=[...opts.children][q.options.findIndex(x=>x.ok)]; right.classList.remove('dim'); right.classList.add('correct'); }
          answered++;
          if(answered===sc.questions.length){ state[i]=Object.assign(state[i]||{},{done:true,score:correct,total:sc.questions.length}); nextBtn.disabled=false; hint.textContent='';
            c.appendChild(el(`<div class="feedback show good" style="margin-top:22px;text-align:center;font-size:clamp(15px,1.3vw,19px)">ענית נכון על <b>${correct}</b> מתוך <b>${sc.questions.length}</b> שאלות.</div>`)); }
        };
        opts.appendChild(b);
      });
      block.appendChild(opts); c.appendChild(block);
    });
    return c;
  },
  end(sc){
    const c = el(`<div class="card"><div class="end"></div></div>`);
    const e = c.querySelector('.end');
    e.appendChild(el(`<img class="seal" src="assets/logo-dark.png" alt="אסלאם">`));
    e.appendChild(el(`<div class="kicker" style="justify-content:center">פרק שישי</div>`));
    e.appendChild(el(`<h1 class="h" style="margin-bottom:10px">${esc(sc.title)}</h1>`));
    e.appendChild(el(`<p class="lead-in" style="margin-bottom:6px">${esc(sc.sub)}</p>`));
    const qz = Object.values(state).find(s=>s&&s.total);
    if(qz) e.appendChild(el(`<div class="score">בבדיקה המסכמת: ${qz.score}/${qz.total}</div>`));
    const act = el('<div class="actions"></div>');
    act.appendChild(el('<a class="btn primary" href="chapters.html">חזרה לפרקי הלמידה<svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></a>'));
    const again = el('<button class="btn ghost">התחל את הפרק מחדש</button>');
    again.onclick=()=>{ for(const k in state) delete state[k]; i=0; render(); };
    act.appendChild(again); e.appendChild(act);
    return c;
  }
};

function shuffle(a){ a=a.slice(); for(let k=a.length-1;k>0;k--){ const j=Math.floor(Math.random()*(k+1)); [a[k],a[j]]=[a[j],a[k]]; } return a; }

render();
</script>
</body>
</html>
