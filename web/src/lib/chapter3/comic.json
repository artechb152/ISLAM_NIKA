   "m": "dust",
   "c": "in"
  },
  {
   "a": "p05",
   "p": 0,
   "b": [
    {
     "t": "הקוראן מספר זאת בסורת הפיל.",
     "s": "§2"
    },
    {
     "t": "ולמה הכשיל אללה את אברהה?",
