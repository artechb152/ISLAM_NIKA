{
  "name": "islam-elearning",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/fix-basepath.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && eslint . && node ../concept/chapter1/verify-dialogue.mjs && node scripts/check-summary-sources.mjs && node scripts/check-camp.mjs && node scripts/check-layouts.mjs && node scripts/check-journey.mjs && node scripts/check-interactions.mjs && node scripts/check-walkable.mjs && node scripts/check-playable.mjs",
    "ch1:verify": "node ../concept/chapter1/verify-dialogue.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:all": "npm run verify && npm run verify:live",
    "audit-assets": "node scripts/audit-assets.mjs",
    "measure-walk": "node scripts/measure-walk.mjs",
    "check-slide": "node scripts/check-slide.mjs",
    "check-keys": "node scripts/check-keys.mjs",
    "explore": "node scripts/explore.mjs",
    "play-scene": "node scripts/play-scene.mjs",
    "check-notebook": "node scripts/check-notebook.mjs",
    "check-yaw": "node scripts/check-yaw.mjs",
    "add-model": "node scripts/import-blend.mjs",
    "check-camp": "node scripts/check-camp.mjs",
    "measure-props": "node scripts/measure-props.mjs",
    "camp:export": "node scripts/camp.mjs export",
    "camp:import": "node scripts/camp.mjs import",
    "ch2:verify": "node ../concept/chapter2/verify-chapter2.mjs",
    "ch2:audit": "node ../concept/chapter2/audit.mjs",
    "check-journey": "node scripts/check-journey.mjs",
    "check-walkable": "node scripts/check-walkable.mjs",
    "check-playable": "node scripts/check-playable.mjs",
    "check-layouts": "node scripts/check-layouts.mjs",
    "check-interactions": "node scripts/check-interactions.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "next": "^16.2.10",
    "postprocessing": "^6.39.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "playwright-core": "^1.62.1",
    "puppeteer-core": "^25.8.0",
    "typescript": "^5.9.3"
  }
}
