{
  "name": "islam-elearning",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/fix-basepath.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && eslint . && node scripts/check-summary-sources.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:all": "npm run verify && npm run verify:live",
    "topics": "node scripts/build-chapter-topics.cjs src/lib",
    "ch1:verify": "node ../concept/chapter1/verify-article.mjs",
    "ch2:verify": "node ../concept/chapter2/verify-chapter2.mjs",
    "ch4:verify": "node ../concept/chapter4/verify-chapter4.mjs",
    "ch2:audit": "node ../concept/chapter2/audit.mjs",
    "ch3:verify": "node ../concept/chapter3/verify-chapter3.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "next": "^16.2.10",
    "postprocessing": "^6.39.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "playwright-core": "^1.62.1",
    "puppeteer-core": "^25.8.0",
    "typescript": "^5.9.3"
  }
}
