{
  "name": "islam-elearning",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/fix-basepath.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && node scripts/check-summary-sources.mjs && node scripts/check-camp.mjs",
    "add-model": "node scripts/import-blend.mjs",
    "check-camp": "node scripts/check-camp.mjs",
    "measure-props": "node scripts/measure-props.mjs",
    "camp:export": "node scripts/camp.mjs export",
    "camp:import": "node scripts/camp.mjs import"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "typescript": "^5.9.3"
  }
}
